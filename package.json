{
  "name": "@anas/pi-pr-agents",
  "version": "0.1.0",
  "description": "Graphite/PR-stack orchestration for pi: a main agent that splits work into PRs, dispatches a dedicated worktree subagent per PR, and lays them out as labelled tmux panes.",
  "author": "anas",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pr",
    "graphite",
    "worktree",
    "tmux",
    "subagent"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/pr-agents.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
